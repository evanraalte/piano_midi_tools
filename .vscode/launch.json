{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Color picker",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "color-picker",
                "--video-path",
                "wind.mkv",
                "--colors-path",
                "colors-wind.yaml",
                "--frame-end",
                "250"
            ]
        },
        {
            "name": "Key picker",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "key-picker",
                "--video-path",
                "wind.mkv",
                "--key-segments-path",
                "keys-wind.yaml",
            ]
        },
        {
            "name": "Video to midi",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "video-to-midi",
                "--video-path",
                "wind.mkv",
                "--key-segments-path",
                "keys-wind.yaml",
                "--colors-path",
                "colors-wind.yaml",
                "--midi-path",
                "wind.midi",
            ]
        }
    ]
}
